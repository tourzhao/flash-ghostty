# Canonical shell-facing identity for the FLASH-Ghostty fork.
# Keep this file POSIX-shell compatible: CI sources it directly.
FLASH_GHOSTTY_DISPLAY_NAME=FLASH-Ghostty
FLASH_GHOSTTY_RELEASE_BUNDLE_ID=com.flashghostty.app
FLASH_GHOSTTY_DEBUG_BUNDLE_ID=com.flashghostty.app.debug
FLASH_GHOSTTY_FILESYSTEM_NAMESPACE=flash-ghostty
FLASH_GHOSTTY_APP_BUNDLE=FLASH-Ghostty.app
FLASH_GHOSTTY_ARTIFACT_BASENAME=flash-ghostty-macos-universal
FLASH_GHOSTTY_REPOSITORY=tourzhao/flash-ghostty
FLASH_GHOSTTY_UPSTREAM_URL=https://github.com/ghostty-org/ghostty.git
FLASH_GHOSTTY_UPSTREAM_BRANCH=main
FLASH_GHOSTTY_UPDATE_ENABLED=false
