# Source-controlled release metadata for FLASH-Ghostty.
#
# The repository does not yet contain an authoritative record of previously
# published FLASH-Ghostty bundle versions. Keep both values empty until the
# owner has reconciled the published history, then update them together in the
# protected release commit. FLASH_GHOSTTY_BUNDLE_VERSION must be strictly
# greater than every previously shipped bundle version. The release workflow
# fails closed while either value is empty or malformed.
FLASH_GHOSTTY_RELEASE_METADATA_SCHEMA=1
FLASH_GHOSTTY_RELEASE_VERSION=
FLASH_GHOSTTY_BUNDLE_VERSION=
