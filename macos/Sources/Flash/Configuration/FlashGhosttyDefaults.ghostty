# FLASH-Ghostty product defaults.
#
# This file is loaded before the user's configuration. Keep product opinions
# here instead of changing Ghostty's shared Zig defaults so upstream updates
# remain easy to merge. A user setting always wins over these values.

window-save-state = always
macos-titlebar-style = sidebar
macos-custom-icon = ~/.config/flash-ghostty/FLASH-Ghostty.icns
