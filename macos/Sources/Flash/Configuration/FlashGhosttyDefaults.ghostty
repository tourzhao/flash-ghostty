# FLASH-Ghostty product defaults.
#
# This file is loaded before the user's configuration. Keep product opinions
# here instead of changing Ghostty's shared Zig defaults so upstream updates
# remain easy to merge. A user setting always wins over these values.

window-save-state = always
macos-titlebar-style = sidebar
macos-custom-icon = ~/.config/flash-ghostty/FLASH-Ghostty.icns

# FLASH navigation pins operate on terminal-owned scrollback. Claude's
# fullscreen renderer keeps a private virtual history that terminals cannot
# navigate, so use its supported main-screen renderer in new FLASH sessions.
# A user can remove this default with:
# env = CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=
env = CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=1
